apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ lease_claim_name }}
  namespace: {{ namespace }}
  annotations:
    argocd.argoproj.io/sync-wave: "{{ worker_dhcp_sync_wave }}"
    argocd.argoproj.io/sync-options: Prune=false
  labels:
    app.kubernetes.io/name: {{ server_name }}
    {{ api_group }}/authority: worker-dhcp
spec:
  accessModes:
  - {{ lease_access_mode }}
  resources:
    requests:
      storage: {{ lease_storage_size }}
  storageClassName: {{ lease_storage_class }}
  volumeMode: {{ lease_volume_mode }}
