import argparse
import fcntl
import hashlib
import json
import math
import os
import socket
import stat
import struct
import subprocess
import threading
import time
import uuid
from ipaddress import IPv4Address, IPv4Network

SO_BINDTODEVICE = 25
LEASE_FILE = {{ observed_lease_file_json }}
LEASE_MOUNT = {{ lease_mount_path_json }}
AUTHORITY_ID = {{ authority_id_json }}
LEASE_CLAIM_NAME = {{ lease_claim_name_json }}
CLOCK_SKEW_SECONDS = {{ clock_skew_seconds }}
INTERFACES = json.loads({{ interface_config_json_literal }})
LEASES = {}
STORE = None
STORE_MOUNT_ID = None
AUTHORITY_LOCK_FILE = os.path.join(LEASE_MOUNT, ".authority.lock")
AUTHORITY_LOCK_FD = None
AUTHORITY_LOCK_ID = None
AUTHORITY_LOCK_MOUNT_ID = None
LEASE_LOCK = threading.RLock()
FAILED = threading.Event()


class LeaseStoreError(RuntimeError):
    pass


def fail_closed(reason):
    with LEASE_LOCK:
        FAILED.set()
    print(f"DHCP authority fail closed: {reason}", flush=True)


def ip(addr):
    return socket.inet_aton(addr)


def option(code, payload):
    return bytes([code, len(payload)]) + payload


def parse_options(packet):
    options = {}
    index = 240
    while index < len(packet):
        code = packet[index]
        index += 1
        if code == 255:
            return options
        if code == 0:
            continue
        if index >= len(packet):
            return None
        length = packet[index]
        index += 1
        if index + length > len(packet):
            return None
        options[code] = packet[index:index + length]
        index += length
    return None


def mac_from(packet):
    return ":".join(f"{octet:02x}" for octet in packet[28:34])


def packet_address(packet, offset):
    return socket.inet_ntoa(packet[offset:offset + 4])


def lease_key(mac, config):
    return f"{config['scope_id']}:{mac.lower()}"


def address_in_pool(address, config):
    value = int(IPv4Address(address))
    return int(IPv4Address(config["range_start"])) <= value <= int(IPv4Address(config["range_end"]))


def validate_interfaces(configs):
    interfaces = set()
    scope_ids = set()
    endpoint_names = set()
    authorities = []
    for config in configs:
        interface = config.get("interface")
        scope_id = config.get("scope_id")
        endpoint_name = config.get("name")
        if not interface or interface in interfaces:
            raise ValueError(f"duplicate or missing DHCP interface {interface!r}")
        if not scope_id or scope_id in scope_ids:
            raise ValueError(f"duplicate or missing DHCP scope {scope_id!r}")
        if not endpoint_name or endpoint_name in endpoint_names:
            raise ValueError(f"duplicate or missing DHCP endpoint {endpoint_name!r}")
        interfaces.add(interface)
        scope_ids.add(scope_id)
        endpoint_names.add(endpoint_name)

        authority = IPv4Network(config["address_authority"], strict=False)
        server = IPv4Address(config["server"])
        start = IPv4Address(config["range_start"])
        end = IPv4Address(config["range_end"])
        if server not in authority or start not in authority or end not in authority:
            raise ValueError(f"DHCP scope {scope_id} addresses must be inside {authority}")
        if start > end or int(start) <= int(server) <= int(end):
            raise ValueError(f"DHCP scope {scope_id} has an invalid or server-overlapping pool")
        for other_scope, other_authority in authorities:
            if authority.overlaps(other_authority):
                raise ValueError(
                    f"DHCP scopes {other_scope} and {scope_id} overlap in one server network namespace"
                )
        authorities.append((scope_id, authority))

        transport = config.get("transport")
        mode = config.get("mode")
        if transport != "broadcast":
            raise ValueError(f"DHCP scope {scope_id} must use same-domain broadcast transport")
        if mode not in {"dynamic", "reservation"}:
            raise ValueError(f"DHCP scope {scope_id} has unsupported allocation mode {mode!r}")

        seen_macs = set()
        seen_ips = set()
        for reservation in config.get("reservations") or []:
            mac = reservation.get("mac", "").lower()
            address = reservation.get("ip", "")
            if not mac or mac in seen_macs or address in seen_ips or not address_in_pool(address, config):
                raise ValueError(f"DHCP scope {scope_id} has an invalid duplicate reservation")
            seen_macs.add(mac)
            seen_ips.add(address)


def valid_lease(key, lease, configs_by_scope, now=None):
    if not isinstance(lease, dict) or ":" not in key:
        return False
    scope_id = lease.get("scopeId")
    config = configs_by_scope.get(scope_id)
    mac = str(lease.get("mac", "")).lower()
    if config is None or not mac or key != lease_key(mac, config):
        return False
    if lease.get("network") != config.get("network") or lease.get("subnet") != config.get("subnet"):
        return False
    if lease.get("mode") != config.get("mode"):
        return False
    if lease.get("state") not in {"offered", "bound"}:
        return False
    try:
        if not address_in_pool(lease.get("ip", ""), config):
            return False
    except ValueError:
        return False
    if config.get("mode") == "reservation":
        reservation = reservation_for(mac, config)
        if reservation is None or reservation.get("ip") != lease.get("ip"):
            return False
    expires_at = lease.get("expiresAt")
    try:
        expires_at = float(expires_at)
    except (TypeError, ValueError):
        return False
    if not math.isfinite(expires_at) or expires_at <= (time.time() if now is None else now):
        return False
    return True


def scope_digest():
    """Bind retained state to the exact resolved DHCP authority and lease policy."""
    fields = (
        "scope_id", "network", "subnet", "address_authority", "server",
        "range_start", "range_end", "router", "dns", "mode", "lease_seconds",
    )
    scopes = [{key: config[key] for key in fields} for config in
              sorted(INTERFACES, key=lambda item: item["scope_id"])]
    encoded = json.dumps(scopes, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(encoded).hexdigest()


def mounted_identity():
    if os.path.dirname(LEASE_FILE) != LEASE_MOUNT or not os.path.ismount(LEASE_MOUNT):
        raise LeaseStoreError("retained lease disk is not mounted at its authored path")
    if os.statvfs(LEASE_MOUNT).f_flag & os.ST_RDONLY:
        raise LeaseStoreError("retained lease disk is read-only")
    filesystem_uuid = subprocess.check_output(
        ["findmnt", "-n", "-o", "UUID", "-M", LEASE_MOUNT], text=True,
    ).strip()
    if not filesystem_uuid:
        raise LeaseStoreError("mounted lease filesystem has no UUID")
    return os.stat(LEASE_MOUNT).st_dev, filesystem_uuid


def acquire_authority_lock():
    """Hold one stable lock inode from startup/initialization until shutdown."""
    global AUTHORITY_LOCK_FD, AUTHORITY_LOCK_ID, AUTHORITY_LOCK_MOUNT_ID
    if AUTHORITY_LOCK_FD is not None:
        return
    mount_id = mounted_identity()
    descriptor = os.open(
        AUTHORITY_LOCK_FILE, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600,
    )
    try:
        identity = os.fstat(descriptor)
        if not stat.S_ISREG(identity.st_mode):
            raise LeaseStoreError("DHCP authority lock is not a regular file")
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise LeaseStoreError("another DHCP authority owns the retained store") from exc
        directory = os.open(LEASE_MOUNT, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
        current = os.lstat(AUTHORITY_LOCK_FILE)
        if ((current.st_dev, current.st_ino) != (identity.st_dev, identity.st_ino)
                or mounted_identity() != mount_id):
            raise LeaseStoreError("DHCP authority lock or retained mount changed")
        AUTHORITY_LOCK_FD = descriptor
        AUTHORITY_LOCK_ID = (identity.st_dev, identity.st_ino)
        AUTHORITY_LOCK_MOUNT_ID = mount_id
    except Exception:
        os.close(descriptor)
        raise


def release_authority_lock():
    global AUTHORITY_LOCK_FD, AUTHORITY_LOCK_ID, AUTHORITY_LOCK_MOUNT_ID
    if AUTHORITY_LOCK_FD is not None:
        os.close(AUTHORITY_LOCK_FD)
    AUTHORITY_LOCK_FD = None
    AUTHORITY_LOCK_ID = None
    AUTHORITY_LOCK_MOUNT_ID = None


def assert_store_ready():
    # Serve loops and packet commits share this lock, so readers cannot observe
    # the interval between an atomic replace and this process updating STORE.
    with LEASE_LOCK:
        if AUTHORITY_LOCK_FD is None:
            raise LeaseStoreError("exclusive DHCP authority lock is not held")
        current = mounted_identity()
        lock_identity = os.fstat(AUTHORITY_LOCK_FD)
        path_identity = os.lstat(AUTHORITY_LOCK_FILE)
        if ((lock_identity.st_dev, lock_identity.st_ino) != AUTHORITY_LOCK_ID
                or (path_identity.st_dev, path_identity.st_ino) != AUTHORITY_LOCK_ID
                or current != AUTHORITY_LOCK_MOUNT_ID):
            raise LeaseStoreError("DHCP authority lock or retained mount changed")
        if STORE_MOUNT_ID is not None and current != STORE_MOUNT_ID:
            raise LeaseStoreError("retained lease filesystem changed while serving")
        if STORE is not None and time.time() + CLOCK_SKEW_SECONDS < STORE["updatedAt"]:
            raise LeaseStoreError("clock moved behind the last durable lease commit")
        if STORE is not None:
            try:
                if read_envelope() != STORE:
                    raise LeaseStoreError("retained lease state changed outside this writer")
            except (OSError, json.JSONDecodeError) as exc:
                raise LeaseStoreError("retained lease state disappeared or became unreadable") from exc
        return current


def read_envelope():
    descriptor = os.open(LEASE_FILE, os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(descriptor) as handle:
        if not stat.S_ISREG(os.fstat(handle.fileno()).st_mode):
            raise LeaseStoreError("retained lease store is not a regular file")
        return json.load(handle)


def write_envelope(envelope, *, create=False):
    assert_store_ready()
    temporary = f"{LEASE_FILE}.tmp.{os.getpid()}.{threading.get_ident()}"
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW
    fd = os.open(temporary, flags, 0o600)
    try:
        with os.fdopen(fd, "w") as handle:
            json.dump(envelope, handle, sort_keys=True, separators=(",", ":"))
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        if create:
            # A first-provision command must never overwrite a recovered store.
            os.link(temporary, LEASE_FILE)
        else:
            os.replace(temporary, LEASE_FILE)
        directory = os.open(LEASE_MOUNT, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def validate_envelope(data, mount_id):
    if not isinstance(data, dict) or data.get("version") != 1:
        raise LeaseStoreError("missing or incompatible lease store version")
    expected = {
        "authorityId": AUTHORITY_ID,
        "claimName": LEASE_CLAIM_NAME,
        "scopeDigest": scope_digest(),
        "filesystemUuid": mount_id[1],
    }
    for key, value in expected.items():
        if data.get(key) != value:
            raise LeaseStoreError(f"lease store {key} does not match this authority")
    try:
        uuid.UUID(data["storeId"])
    except (KeyError, TypeError, ValueError) as exc:
        raise LeaseStoreError("lease store ID is invalid") from exc
    if type(data.get("generation")) is not int or data["generation"] < 0:
        raise LeaseStoreError("lease store generation is invalid")
    maximum = data.get("maxIssuedLeaseSeconds")
    if type(maximum) is not int or maximum < 0:
        raise LeaseStoreError("prior maximum issued lease duration is unknown")
    updated = data.get("updatedAt")
    if (not isinstance(updated, (int, float)) or not math.isfinite(updated)
            or updated < 0 or updated > time.time() + CLOCK_SKEW_SECONDS):
        raise LeaseStoreError("lease store timestamp or local clock is invalid")
    quarantine = data.get("quarantineUntil", 0)
    if (not isinstance(quarantine, (int, float)) or not math.isfinite(quarantine)
            or quarantine < 0):
        raise LeaseStoreError("lease recovery quarantine is invalid")
    if time.time() < quarantine:
        raise LeaseStoreError("prior issued leases have not completed recovery quarantine")
    records = data.get("leases")
    if not isinstance(records, dict):
        raise LeaseStoreError("lease records must be a JSON object")
    configs_by_scope = {config["scope_id"]: config for config in INTERFACES}
    active = {}
    used = set()
    now = time.time()
    for key, lease in records.items():
        if not valid_lease(key, lease, configs_by_scope, now=0):
            raise LeaseStoreError(f"malformed or incompatible retained lease {key!r}")
        issued = lease.get("issuedAt")
        expires = float(lease["expiresAt"])
        if (not isinstance(issued, (int, float)) or not math.isfinite(issued)
                or issued < 0 or issued > expires
                or expires - issued > maximum + CLOCK_SKEW_SECONDS):
            raise LeaseStoreError(f"invalid issued duration for retained lease {key!r}")
        if expires > now:
            if lease["ip"] in used:
                raise LeaseStoreError(f"duplicate live address in retained leases: {lease['ip']}")
            used.add(lease["ip"])
            active[key] = lease
    return active


def load_leases():
    global LEASES, STORE, STORE_MOUNT_ID
    acquired = AUTHORITY_LOCK_FD is None
    if acquired:
        acquire_authority_lock()
    try:
        mount_id = assert_store_ready()
        data = read_envelope()
        active = validate_envelope(data, mount_id)
        STORE_MOUNT_ID = mount_id
        STORE = data
        LEASES = active
    except Exception as exc:
        if acquired:
            release_authority_lock()
        if isinstance(exc, FileNotFoundError):
            raise LeaseStoreError("expected retained lease store is missing") from exc
        if isinstance(exc, (OSError, json.JSONDecodeError)):
            raise LeaseStoreError("retained lease store cannot be read or decoded") from exc
        raise


def write_leases(issued_seconds=0):
    global STORE
    if STORE is None:
        raise LeaseStoreError("retained lease store was not validated")
    assert_store_ready()
    now = time.time()
    next_store = dict(STORE)
    next_store["generation"] += 1
    next_store["updatedAt"] = now
    next_store["maxIssuedLeaseSeconds"] = max(
        STORE["maxIssuedLeaseSeconds"], int(issued_seconds),
    )
    next_store["leases"] = {key: dict(lease) for key, lease in LEASES.items()}
    write_envelope(next_store)
    STORE = next_store


def initialize_store(mode, authority, claim, *, legacy_file=None,
                     max_prior_seconds=None, old_fenced_at=None, margin_seconds=None):
    """Explicit offline provisioning; never called by the serving service."""
    if AUTHORITY_LOCK_FD is not None:
        raise LeaseStoreError("serving authority cannot initialize retained state")
    acquire_authority_lock()
    try:
        _initialize_store_locked(
            mode, authority, claim, legacy_file=legacy_file,
            max_prior_seconds=max_prior_seconds, old_fenced_at=old_fenced_at,
            margin_seconds=margin_seconds,
        )
    finally:
        release_authority_lock()


def _initialize_store_locked(mode, authority, claim, *, legacy_file=None,
                             max_prior_seconds=None, old_fenced_at=None,
                             margin_seconds=None):
    validate_interfaces(INTERFACES)
    if authority != AUTHORITY_ID or claim != LEASE_CLAIM_NAME:
        raise LeaseStoreError("first-provision identity confirmation does not match this authority")
    mount_id = mounted_identity()
    if os.path.lexists(LEASE_FILE):
        raise LeaseStoreError("retained store already exists; refusing reinitialization")
    now = time.time()
    leases = {}
    maximum = 0
    quarantine = 0
    recovery = {"mode": mode}
    if mode == "new-scope":
        if any(value is not None for value in
               (legacy_file, max_prior_seconds, old_fenced_at, margin_seconds)):
            raise LeaseStoreError("new-scope provisioning cannot carry prior-lease inputs")
    elif mode in {"import", "quarantine"}:
        if (type(max_prior_seconds) is not int or max_prior_seconds <= 0
                or not isinstance(old_fenced_at, (int, float))
                or not math.isfinite(old_fenced_at) or old_fenced_at < 0
                or old_fenced_at > now + CLOCK_SKEW_SECONDS
                or type(margin_seconds) is not int or margin_seconds < 0):
            raise LeaseStoreError("recovery requires measured old-writer stop, maximum actually issued lease, and margin")
        maximum = max_prior_seconds
        recovery.update({"oldFencedAt": old_fenced_at,
                         "maxPriorIssuedSeconds": maximum,
                         "clockNetworkMarginSeconds": margin_seconds})
        if mode == "quarantine":
            if legacy_file is not None:
                raise LeaseStoreError("quarantine cannot import an unverified legacy file")
            quarantine = old_fenced_at + maximum + margin_seconds
        else:
            if not legacy_file:
                raise LeaseStoreError("import requires an exported legacy lease file")
            with open(legacy_file) as handle:
                legacy = json.load(handle)
            if not isinstance(legacy, dict):
                raise LeaseStoreError("legacy lease export must be a JSON object")
            by_scope = {config["scope_id"]: config for config in INTERFACES}
            used = set()
            for key, source in legacy.items():
                if not valid_lease(key, source, by_scope, now=0):
                    raise LeaseStoreError(f"invalid legacy lease {key!r}")
                expiry = float(source["expiresAt"])
                if expiry <= now:
                    continue
                if expiry - now > maximum + margin_seconds:
                    raise LeaseStoreError(f"legacy lease exceeds recorded maximum issued duration: {key!r}")
                if source["ip"] in used:
                    raise LeaseStoreError(f"duplicate live legacy address: {source['ip']}")
                used.add(source["ip"])
                record = dict(source)
                record["issuedAt"] = max(0, expiry - maximum)
                leases[key] = record
            with open(legacy_file, "rb") as handle:
                recovery["sourceSha256"] = hashlib.sha256(handle.read()).hexdigest()
    else:
        raise LeaseStoreError(f"unsupported first-provision mode {mode!r}")
    envelope = {
        "version": 1,
        "authorityId": AUTHORITY_ID,
        "claimName": LEASE_CLAIM_NAME,
        "scopeDigest": scope_digest(),
        "filesystemUuid": mount_id[1],
        "storeId": str(uuid.uuid4()),
        "generation": 0,
        "maxIssuedLeaseSeconds": maximum,
        "updatedAt": now,
        "quarantineUntil": quarantine,
        "recovery": recovery,
        "leases": leases,
    }
    write_envelope(envelope, create=True)
    print(f"retained DHCP store initialized mode={mode} authority={AUTHORITY_ID}", flush=True)


def reservation_for(mac, config):
    wanted = mac.lower()
    for reservation in config.get("reservations") or []:
        if reservation.get("mac", "").lower() == wanted:
            return reservation
    return None


def requested_address(options):
    if options.get(50) and len(options[50]) == 4:
        return socket.inet_ntoa(options[50])
    return None


def prune_expired_scope_leases(config):
    configs_by_scope = {config["scope_id"]: config}
    stale = [
        key for key, lease in LEASES.items()
        if key.startswith(f"{config['scope_id']}:") and not valid_lease(key, lease, configs_by_scope)
    ]
    for key in stale:
        del LEASES[key]
    if stale:
        write_leases()


def dynamic_assignment(mac, config, options, request_type):
    prune_expired_scope_leases(config)
    key = lease_key(mac, config)
    existing = LEASES.get(key) or {}
    if existing.get("ip") and address_in_pool(existing["ip"], config):
        requested = requested_address(options)
        if request_type == 3 and requested and requested != existing["ip"]:
            return None
        return {
            "ip": existing["ip"],
            "mac": mac,
            "router": config.get("router", ""),
            "dns": config.get("dns") or [],
            "hostname": existing.get("hostname", ""),
            "defaultRoute": bool(config.get("router")),
        }

    used = {
        lease.get("ip")
        for lease_key_value, lease in LEASES.items()
        if lease_key_value.startswith(f"{config['scope_id']}:") and isinstance(lease, dict)
    }
    requested = requested_address(options)
    if request_type == 3 and requested and (not address_in_pool(requested, config) or requested in used):
        return None
    start = int(IPv4Address(config["range_start"]))
    end = int(IPv4Address(config["range_end"]))
    choices = [requested] if requested else []
    choices.extend(str(IPv4Address(value)) for value in range(start, end + 1))
    for choice in choices:
        if choice and address_in_pool(choice, config) and choice not in used:
            return {
                "ip": choice,
                "mac": mac,
                "router": config.get("router", ""),
                "dns": config.get("dns") or [],
                "hostname": "",
                "defaultRoute": bool(config.get("router")),
            }
    return None


def record_lease(mac, config, reservation, state):
    issued_at = time.time()
    LEASES[lease_key(mac, config)] = {
        "ip": reservation["ip"],
        "mac": mac,
        "network": config["network"],
        "subnet": config["subnet"],
        "scopeId": config["scope_id"],
        "hostname": reservation.get("hostname", ""),
        "mode": config["mode"],
        "state": state,
        "issuedAt": issued_at,
        "expiresAt": issued_at + int(config["lease_seconds"]),
    }
    write_leases(int(config["lease_seconds"]))


def render_options(message_type, reservation, config, request_options):
    lease_seconds = int(config["lease_seconds"])
    rendered = [
        option(53, bytes([message_type])),
        option(54, ip(config["server"])),
        option(51, struct.pack("!I", lease_seconds)),
    ]
    # DHCP option 55 is advisory. The authored fixture policy remains
    # authoritative: a client cannot enable a disabled option or suppress an
    # option whose necessity was established by the consumer validation card.
    # Keeping this independent of the PRL makes minimum-versus-additive probes
    # deterministic across DHCP clients.
    emit_options = set(config["emit_options"])
    if "renewal" in emit_options:
        rendered.append(option(58, struct.pack("!I", lease_seconds // 2)))
        rendered.append(option(59, struct.pack("!I", lease_seconds * 7 // 8)))
    if "subnet-mask" in emit_options:
        rendered.append(option(1, ip(config["subnet_mask"])))
    router = reservation.get("router")
    if "router" in emit_options and router:
        rendered.append(option(3, ip(router)))
    dns = reservation.get("dns") or []
    if "dns" in emit_options and dns:
        rendered.append(option(6, b"".join(ip(server) for server in dns)))
    mtu = config.get("mtu")
    if "mtu" in emit_options and mtu:
        rendered.append(option(26, struct.pack("!H", int(mtu))))
    hostname = reservation.get("hostname") or ""
    if "hostname" in emit_options and hostname:
        rendered.append(option(12, hostname.encode()))
    return b"".join(rendered) + b"\xff"


def render_reply(request, reservation, config, message_type, request_options):
    header = (
        b"\x02" + request[1:3] + b"\x00" + request[4:8] +
        b"\x00\x00" + request[10:12] +
        b"\x00\x00\x00\x00" + ip(reservation["ip"]) + ip(config["server"]) +
        request[24:28] + request[28:44] + b"\x00" * 64 + b"\x00" * 128 +
        b"\x63\x82\x53\x63"
    )
    return header + render_options(message_type, reservation, config, request_options)


def request_matches_scope(packet, options, config):
    server_identifier = options.get(54)
    if server_identifier and server_identifier != ip(config["server"]):
        return False
    giaddr = packet_address(packet, 24)
    ciaddr = packet_address(packet, 12)
    if ciaddr != "0.0.0.0" and IPv4Address(ciaddr) not in IPv4Network(config["address_authority"]):
        return False
    return giaddr == "0.0.0.0"


def reply_destination(packet, config):
    return "255.255.255.255", 68


def process_packet(packet, config):
    if FAILED.is_set():
        raise LeaseStoreError("DHCP authority was already shut down")
    if (
        len(packet) < 240
        or packet[0:3] != b"\x01\x01\x06"
        or packet[236:240] != b"\x63\x82\x53\x63"
    ):
        return None
    options = parse_options(packet)
    if options is None or not options.get(53):
        return None
    request_type = options[53][0]
    if request_type not in (1, 3) or not request_matches_scope(packet, options, config):
        return None
    mac = mac_from(packet)
    with LEASE_LOCK:
        if FAILED.is_set():
            raise LeaseStoreError("DHCP authority was already shut down")
        try:
            assert_store_ready()
            reservation = reservation_for(mac, config)
            if not reservation and config["mode"] == "dynamic":
                reservation = dynamic_assignment(mac, config, options, request_type)
            if not reservation:
                return None
            requested = requested_address(options)
            if request_type == 3 and requested and requested != reservation["ip"]:
                return None
            reply_type = 2 if request_type == 1 else 5
            record_lease(mac, config, reservation, "offered" if request_type == 1 else "bound")
        except Exception as exc:
            fail_closed(exc)
            raise
    return (
        render_reply(packet, reservation, config, reply_type, options),
        reply_destination(packet, config),
        reservation,
        request_type,
        reply_type,
    )


def serve(config):
    interface = config["interface"]
    sock = None
    try:
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEPORT, 1)
        except OSError:
            pass
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        sock.setsockopt(socket.SOL_SOCKET, SO_BINDTODEVICE, interface.encode() + b"\0")
        sock.bind(("", 67))
        sock.settimeout(1)
        print(
            f"listening on {interface} as {config['server']} scope={config['scope_id']} "
            f"transport={config['transport']}", flush=True,
        )
        while not FAILED.is_set():
            assert_store_ready()
            try:
                packet, peer = sock.recvfrom(1500)
            except socket.timeout:
                continue
            result = process_packet(packet, config)
            if result is None:
                print(f"unserved DHCP packet peer={peer} scope={config['scope_id']} iface={interface}", flush=True)
                continue
            reply, destination, reservation, request_type, reply_type = result
            with LEASE_LOCK:
                if FAILED.is_set():
                    break
                assert_store_ready()
                sock.sendto(reply, destination)
            print(
                f"served dhcp type={request_type}->{reply_type} mac={reservation['mac']} "
                f"ip={reservation['ip']} scope={config['scope_id']} iface={interface} "
                f"destination={destination[0]}:{destination[1]}", flush=True,
            )
    except Exception as exc:
        fail_closed(exc)
    finally:
        if sock is not None:
            sock.close()


def main():
    parser = argparse.ArgumentParser(description="Single-writer external DHCP authority")
    parser.add_argument("--initialize-store", choices=("new-scope", "import", "quarantine"))
    parser.add_argument("--confirm-authority")
    parser.add_argument("--confirm-claim")
    parser.add_argument("--legacy-file")
    parser.add_argument("--max-prior-issued-seconds", type=int)
    parser.add_argument("--old-fenced-at", type=float)
    parser.add_argument("--clock-network-margin-seconds", type=int)
    args = parser.parse_args()
    validate_interfaces(INTERFACES)
    if args.initialize_store:
        initialize_store(
            args.initialize_store, args.confirm_authority, args.confirm_claim,
            legacy_file=args.legacy_file,
            max_prior_seconds=args.max_prior_issued_seconds,
            old_fenced_at=args.old_fenced_at,
            margin_seconds=args.clock_network_margin_seconds,
        )
        return
    load_leases()
    try:
        threads = []
        for config in INTERFACES:
            thread = threading.Thread(target=serve, args=(config,))
            thread.start()
            threads.append(thread)
        for thread in threads:
            thread.join()
    finally:
        release_authority_lock()
    if FAILED.is_set():
        raise LeaseStoreError("a DHCP scope failed; all serving threads stopped")


if __name__ == "__main__":
    main()
