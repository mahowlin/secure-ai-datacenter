apiVersion: v1
kind: ConfigMap
metadata:
  name: hcp-distribution-config
  namespace: {{ namespace }}
data:
  config.yml: |
    version: 0.1
    log:
      level: info
    storage:
      filesystem:
        rootdirectory: /var/lib/registry
      delete:
        enabled: false
    http:
      addr: 127.0.0.1:{{ listeners.distribution }}
  nginx.conf: |
    worker_processes 1;
    pid /tmp/nginx.pid;
    events { worker_connections 1024; }
    http {
      access_log /dev/stdout;
      error_log /dev/stderr warn;
      client_max_body_size 0;
      proxy_request_buffering off;
      proxy_buffering off;
      proxy_read_timeout 600s;
      proxy_send_timeout 600s;
      server {
        listen {{ listeners.pull }} ssl;
        server_name {{ pull_service }}.{{ namespace }}.svc;
        ssl_certificate /run/pull-tls/tls.crt;
        ssl_certificate_key /run/pull-tls/tls.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        location = /healthz { auth_basic off; return 200; }
        location /v2/ {
          auth_basic "hcp-registry-pull";
          auth_basic_user_file /run/pull-auth/htpasswd;
          limit_except GET { deny all; }
          proxy_pass http://127.0.0.1:{{ listeners.distribution }};
          proxy_http_version 1.1;
          proxy_set_header Connection "";
          proxy_set_header Host $http_host;
          proxy_set_header X-Forwarded-Proto https;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
      }
{% if external_pull %}
      server {
        listen {{ external_pull.listenerPort }} ssl;
        server_name {{ external_pull.sans | join(' ') }};
        ssl_certificate /run/external-tls/tls.crt;
        ssl_certificate_key /run/external-tls/tls.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        location /v2/ {
          auth_basic "registry-pull";
          auth_basic_user_file /run/pull-auth/htpasswd;
          limit_except GET { deny all; }
          proxy_pass http://127.0.0.1:{{ listeners.distribution }};
          proxy_http_version 1.1;
          proxy_set_header Connection "";
          proxy_set_header Host $http_host;
          proxy_set_header X-Forwarded-Proto https;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
      }
{% endif %}
      server {
        listen {{ listeners.sync }} ssl;
        server_name {{ sync_service }}.{{ namespace }}.svc;
        ssl_certificate /run/sync-tls/tls.crt;
        ssl_certificate_key /run/sync-tls/tls.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        location = /healthz { auth_basic off; return 200; }
        location /v2/ {
          auth_basic "hcp-registry-sync";
          auth_basic_user_file /run/sync-auth/htpasswd;
          proxy_pass http://127.0.0.1:{{ listeners.distribution }};
          proxy_http_version 1.1;
          proxy_set_header Connection "";
          proxy_set_header Host $http_host;
          proxy_set_header X-Forwarded-Proto https;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
      }
    }
