apiVersion: v1
kind: Service
metadata:
  name: {{ pull_service }}
  namespace: {{ namespace }}
  annotations:
    service.beta.openshift.io/serving-cert-secret-name: {{ pull_tls_secret }}
spec:
  type: ClusterIP
  selector:
    app: {{ workload_name }}
  ports:
    - name: https
      port: 5000
      targetPort: pull-https
