# Generated by render-aci.py — do not edit manually.
# Management tenant: routing domain, bridge domain and endpoint attachment.
apic:
  tenants:
  - name: {{ config.tenant }}
    vrfs:
    - name: {{ config.vrf }}
    bridge_domains:
    - name: {{ config.bridgeDomain }}
      vrf: {{ config.vrf }}
      l3outs: [{{ config.siteL3Out }}]
      subnets:
      - ip: {{ gateway_prefix }}
    application_profiles:
    - name: {{ config.applicationProfile }}
      endpoint_groups:
      - name: {{ config.endpointGroup }}
        bridge_domain: {{ config.bridgeDomain }}
        contracts:
          consumers: [{{ config.siteContract }}]
          providers: [{{ config.siteContract }}]
        physical_domains:
        - {{ config.physicalDomain }}
        static_ports:
{% for port in config.serverPorts %}
        - pod_id: {{ port.podId }}
          node_id: {{ port.nodeId }}
          module: {{ port.module }}
          port: {{ port.port }}
          vlan: {{ network.vlan }}
          mode: untagged
{% endfor -%}
