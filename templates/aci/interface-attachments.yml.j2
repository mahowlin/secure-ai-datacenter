# Generated by render-aci.py — do not edit manually.
# Management and tenant physical leaf attachments.
apic:
  access_policies:
    leaf_interface_policy_groups:
{% for side in sides %}
    - name: {{ side.aaep }}-access
      type: access
      aaep: {{ side.aaep }}
{% endfor %}
    leaf_interface_profiles:
{% for side in sides %}
{% for leaf, ports in side.leaves.items() %}
    - name: {{ side.aaep }}-leaf{{ leaf }}
      selectors:
{% for port in ports %}
      - name: {{ port.host }}-{{ side.role }}
        policy_group: {{ side.aaep }}-access
        port_blocks:
        - name: {{ port.host }}
          from_module: {{ port.module }}
          from_port: {{ port.port }}
{% endfor %}
{% endfor %}
{% endfor %}
    leaf_switch_profiles:
{% for side in sides %}
{% for leaf, ports in side.leaves.items() %}
    - name: {{ side.aaep }}-leaf{{ leaf }}
      interface_profiles: [{{ side.aaep }}-leaf{{ leaf }}]
      selectors:
      - name: leaf{{ leaf }}
        node_blocks:
        - name: leaf{{ leaf }}
          from: {{ leaf }}
{% endfor %}
{% endfor %}
