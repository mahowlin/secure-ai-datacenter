{#- NAC ACI access policies template — generated by render-aci.py from resolved platform data.
   Do not edit generated output manually; modify this template or platform contract instead.

   Template variables (all required — no Jinja default() allowed):
     tenant_name        — ACI tenant name (e.g. "example-tenant-a")
     shared_aaep        — existing shared AAEP name (e.g. "example-L2_AttEntityP")
     vlan_pools         — list of {name, allocation, ranges: [{from, to, role}]}
     physical_domain    — {name, vlan_pool, vlan_pool_allocation}
     routed_domains     — list of {name, vlan_pool, vlan_pool_allocation, aaep}
     extra_aaeps        — list of {name, routed_domains}
#}
# Generated by render-aci.py — do not edit manually.
# Access policies for {{ tenant_name }}: VLAN pool, physical/routed domains, AAEP binding

apic:
  access_policies:
    vlan_pools:
{%- for pool in vlan_pools %}
    - name: {{ pool.name }}
      allocation: {{ pool.allocation }}
      ranges:
{%- for r in pool.ranges %}
      - from: {{ r.from }}
        to: {{ r.to }}
        role: {{ r.role }}
{%- endfor %}
{%- endfor %}
    physical_domains:
    - name: {{ physical_domain.name }}
      vlan_pool: {{ physical_domain.vlan_pool }}
      vlan_pool_allocation: {{ physical_domain.vlan_pool_allocation }}
{%- if routed_domains %}
    routed_domains:
{%- for rd in routed_domains %}
    - name: {{ rd.name }}
      vlan_pool: {{ rd.vlan_pool }}
      vlan_pool_allocation: {{ rd.vlan_pool_allocation }}
{%- endfor %}
{%- endif %}
    aaeps:
    - name: {{ shared_aaep }}
      physical_domains:
      - {{ physical_domain.name }}
{%- set shared_routed = routed_domains | selectattr('aaep', 'equalto', shared_aaep) | list %}
{%- if shared_routed %}
      routed_domains:
{%- for rd in shared_routed %}
      - {{ rd.name }}
{%- endfor %}
{%- endif %}
{%- for aaep in extra_aaeps %}
    - name: {{ aaep.name }}
      routed_domains:
{%- for rd in aaep.routed_domains %}
      - {{ rd }}
{%- endfor %}
{%- endfor %}
