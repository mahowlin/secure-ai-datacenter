{#- NAC ACI tenant template — generated by render-aci.py from resolved platform data.
   Do not edit generated output manually; modify this template or platform contract instead.

   Template variables (all required — no Jinja default() allowed):
     tenant_name        — ACI tenant name (e.g. "example-tenant-a")
     vrf_name           — VRF name (e.g. "VRF-A")
     bridge_domains     — list of {name, vrf, subnets?[{ip, public}]}
     app_profiles       — list of {name, endpoint_groups: [{name, bridge_domain, subnets?, contracts?, vmware_vmm_domains?[{name}]}]}
     l3outs             — list of consolidated tenant L3Out dicts with per-leaf floating SVI interfaces
     contracts          — list of {name, scope, subjects: [{name, filters: [{filter}]}]}
     filters            — list of {name, entries: [{name, ethertype, protocol}]}
     policies           — dict with bfd_interface_policies, bgp_best_path_policies, bgp_peer_prefix_policies
     match_rules        — list of {name, prefixes: [{ip}]} for route control
#}
# Generated by render-aci.py — do not edit manually.
# Tenant: {{ tenant_name }}

apic:
  tenants:
  - name: {{ tenant_name }}
    vrfs:
    - name: {{ vrf_name }}
{%- if bridge_domains %}
    bridge_domains:
{%- for bd in bridge_domains %}
    - name: {{ bd.name }}
      vrf: {{ bd.vrf }}
{%- if bd.subnets is defined and bd.subnets %}
      subnets:
{%- for sub in bd.subnets %}
      - ip: {{ sub.ip }}
        public: {{ sub.public | lower }}
{%- if sub.shared is defined %}
        shared: {{ sub.shared | lower }}
{%- endif %}
{%- endfor %}
{%- endif %}
{%- if bd.l3outs is defined and bd.l3outs %}
      l3outs:
{%- for l3out in bd.l3outs %}
      - {{ l3out }}
{%- endfor %}
{%- endif %}
{%- endfor %}
{%- endif %}
{%- if app_profiles %}
    application_profiles:
{%- for ap in app_profiles %}
    - name: {{ ap.name }}
      endpoint_groups:
{%- for epg in ap.endpoint_groups %}
      - name: {{ epg.name }}
        bridge_domain: {{ epg.bridge_domain }}
{%- if epg.subnets is defined and epg.subnets %}
        subnets:
{%- for sub in epg.subnets %}
        - ip: {{ sub.ip }}
          public: {{ sub.public | lower }}
{%- if sub.shared is defined and sub.shared %}
          shared: {{ sub.shared | lower }}
{%- endif %}
{%- endfor %}
{%- endif %}
{%- if epg.contracts is defined and epg.contracts %}
        contracts:
{%- if epg.contracts.providers is defined %}
          providers:
{%- for c in epg.contracts.providers %}
          - {{ c }}
{%- endfor %}
{%- endif %}
{%- if epg.contracts.consumers is defined %}
          consumers:
{%- for c in epg.contracts.consumers %}
          - {{ c }}
{%- endfor %}
{%- endif %}
{%- endif %}
{%- if epg.vmware_vmm_domains is defined and epg.vmware_vmm_domains %}
        vmware_vmm_domains:
{%- for vmm in epg.vmware_vmm_domains %}
        - name: {{ vmm.name }}
{%- endfor %}
{%- endif %}
{%- endfor %}
{%- endfor %}
{%- endif %}
{%- if l3outs %}
    l3outs:
{%- for l3out in l3outs %}
    - name: {{ l3out.name }}
      description: {{ l3out.description }}
      vrf: {{ l3out.vrf }}
      domain: {{ l3out.domain }}
{%- if l3out.export_route_map is defined %}
      export_route_map:
        name: {{ l3out.export_route_map.name }}
        description: {{ l3out.export_route_map.description }}
        type: {{ l3out.export_route_map.type }}
        contexts:
{%- for ctx in l3out.export_route_map.contexts %}
        - name: {{ ctx.name }}
          action: {{ ctx.action }}
          order: {{ ctx.order }}
{%- if ctx.match_rules is defined and ctx.match_rules %}
          match_rules:
{%- for rule in ctx.match_rules %}
          - {{ rule }}
{%- endfor %}
{%- endif %}
{%- endfor %}
{%- endif %}
{%- if l3out.export_route_control_enforcement is defined %}
      export_route_control_enforcement: {{ l3out.export_route_control_enforcement | lower }}
{%- endif %}
{%- if l3out.interleak_route_map is defined %}
      interleak_route_map: {{ l3out.interleak_route_map }}
{%- endif %}
{%- if l3out.ospf is defined %}
      ospf:
        area: {{ l3out.ospf.area }}
        area_type: {{ l3out.ospf.area_type }}
{%- endif %}
{%- if l3out.redistribution_route_maps is defined and l3out.redistribution_route_maps %}
      redistribution_route_maps:
{%- for rm in l3out.redistribution_route_maps %}
      - source: {{ rm.source }}
        route_map: {{ rm.route_map }}
{%- endfor %}
{%- endif %}
      node_profiles:
{%- for np in l3out.node_profiles %}
      - name: {{ np.name }}
        nodes:
{%- for node in np.nodes %}
        - node_id: {{ node.node_id }}
          router_id: {{ node.router_id }}
{%- if node.router_id_as_loopback is defined %}
          router_id_as_loopback: {{ node.router_id_as_loopback | lower }}
{%- endif %}
{%- endfor %}
        bgp: {}
        interface_profiles:
{%- for ip in np.interface_profiles %}
        - name: {{ ip.name }}
{%- if ip.bfd_policy is defined %}
          bfd_policy: {{ ip.bfd_policy }}
{%- endif %}
{%- if ip.ospf_interface_policy is defined %}
          ospf_interface_policy: {{ ip.ospf_interface_policy }}
{%- endif %}
{%- if ip.ospf is defined %}
          ospf:
            policy: {{ ip.ospf.policy }}
{%- endif %}
          interfaces:
{%- for iface in ip.interfaces %}
          - svi: {{ iface.svi | lower }}
{%- if iface.floating_svi is defined %}
            floating_svi: {{ iface.floating_svi | lower }}
{%- endif %}
            node_id: {{ iface.node_id }}
{%- if iface.port is defined %}
            port: {{ iface.port }}
{%- endif %}
            vlan: {{ iface.vlan }}
            ip: {{ iface.ip }}
{%- if iface.ip_shared is defined %}
            ip_shared: {{ iface.ip_shared }}
{%- endif %}
            mtu: {{ iface.mtu }}
{%- if iface.paths is defined %}
            paths:
{%- for path in iface.paths %}
            - physical_domain: {{ path.physical_domain }}
{%- if path.floating_ip is defined %}
              floating_ip: {{ path.floating_ip }}
{%- endif %}
{%- endfor %}
{%- endif %}
{%- if iface.bgp_peers is defined %}
            bgp_peers:
{%- for peer in iface.bgp_peers %}
            - ip: {{ peer.ip }}
              remote_as: {{ peer.remote_as }}
              local_as: {{ peer.local_as }}
              bfd: {{ peer.bfd | lower }}
              as_override: {{ peer.as_override | lower }}
              disable_peer_as_check: {{ peer.disable_peer_as_check | lower }}
              multicast_address_family: {{ peer.multicast_address_family | lower }}
              as_propagate: {{ peer.as_propagate }}
              peer_prefix_policy: {{ peer.peer_prefix_policy }}
{%- endfor %}
{%- endif %}
{%- if iface.ospf is defined %}
            ospf:
              area_id: {{ iface.ospf.area_id }}
              area_type: {{ iface.ospf.area_type }}
{%- endif %}
{%- endfor %}
{%- endfor %}
{%- endfor %}
{%- if l3out.external_endpoint_groups %}
      external_endpoint_groups:
{%- for eepg in l3out.external_endpoint_groups %}
      - name: {{ eepg.name }}
        description: {{ eepg.description }}
{%- if eepg.route_control_profiles is defined and eepg.route_control_profiles %}
        route_control_profiles:
{%- for rcp in eepg.route_control_profiles %}
        - name: {{ rcp.name }}
          direction: {{ rcp.direction }}
{%- endfor %}
{%- endif %}
        subnets:
{%- for sub in eepg.subnets %}
        - prefix: {{ sub.prefix }}
{%- if sub.import_route_control is defined %}
          import_route_control: {{ sub.import_route_control | lower }}
{%- endif %}
{%- if sub.export_route_control is defined %}
          export_route_control: {{ sub.export_route_control | lower }}
{%- endif %}
{%- if sub.shared_route_control is defined %}
          shared_route_control: {{ sub.shared_route_control | lower }}
{%- endif %}
{%- if sub.import_security is defined %}
          import_security: {{ sub.import_security | lower }}
{%- endif %}
{%- if sub.shared_security is defined %}
          shared_security: {{ sub.shared_security | lower }}
{%- endif %}
{%- if sub.bgp_route_summarization is defined %}
          bgp_route_summarization: {{ sub.bgp_route_summarization | lower }}
{%- endif %}
{%- if sub.bgp_route_summarization_policy is defined %}
          bgp_route_summarization_policy: {{ sub.bgp_route_summarization_policy }}
{%- endif %}
{%- if sub.ospf_route_summarization is defined %}
          ospf_route_summarization: {{ sub.ospf_route_summarization | lower }}
{%- endif %}
{%- if sub.ospf_route_summarization_policy is defined %}
          ospf_route_summarization_policy: {{ sub.ospf_route_summarization_policy }}
{%- endif %}
{%- endfor %}
{%- if eepg.contracts is defined and eepg.contracts %}
        contracts:
{%- if eepg.contracts.providers is defined %}
          providers:
{%- for c in eepg.contracts.providers %}
          - {{ c }}
{%- endfor %}
{%- endif %}
{%- if eepg.contracts.consumers is defined %}
          consumers:
{%- for c in eepg.contracts.consumers %}
          - {{ c }}
{%- endfor %}
{%- endif %}
{%- endif %}
{%- endfor %}
{%- endif %}
{%- endfor %}
{%- endif %}
{%- if policies %}
    policies:
      bfd_interface_policies:
{%- for p in policies.bfd_interface_policies %}
      - name: {{ p.name }}
        description: {{ p.description }}
        subinterface_optimization: {{ p.subinterface_optimization | lower }}
        detection_multiplier: {{ p.detection_multiplier }}
        echo_admin_state: {{ p.echo_admin_state | lower }}
        echo_rx_interval: {{ p.echo_rx_interval }}
        min_rx_interval: {{ p.min_rx_interval }}
        min_tx_interval: {{ p.min_tx_interval }}
{%- endfor %}
      bgp_peer_prefix_policies:
{%- for p in policies.bgp_peer_prefix_policies %}
      - name: {{ p.name }}
        description: {{ p.description }}
        action: {{ p.action }}
        threshold: {{ p.threshold }}
        max_prefixes: {{ p.max_prefixes }}
{%- endfor %}
{%- if policies.ospf_interface_policies is defined and policies.ospf_interface_policies %}
      ospf_interface_policies:
{%- for p in policies.ospf_interface_policies %}
      - name: {{ p.name }}
        description: {{ p.description }}
        network_type: {{ p.network_type }}
        mtu_ignore: {{ p.mtu_ignore | lower }}
        advertise_subnet: {{ p.advertise_subnet | lower }}
{%- endfor %}
{%- endif %}
{%- if policies.route_control_route_maps is defined and policies.route_control_route_maps %}
      route_control_route_maps:
{%- for rm in policies.route_control_route_maps %}
      - name: {{ rm.name }}
        description: {{ rm.description }}
        type: {{ rm.type }}
        contexts:
{%- for ctx in rm.contexts %}
        - name: {{ ctx.name }}
          action: {{ ctx.action }}
          order: {{ ctx.order }}
{%- if ctx.match_rules is defined and ctx.match_rules %}
          match_rules:
{%- for rule in ctx.match_rules %}
          - {{ rule }}
{%- endfor %}
{%- endif %}
{%- endfor %}
{%- endfor %}
{%- endif %}
{%- if match_rules %}
      match_rules:
{%- for mr in match_rules %}
      - name: {{ mr.name }}
        prefixes:
{%- for pfx in mr.prefixes %}
        - ip: {{ pfx.ip }}
{%- if pfx.from_length is defined %}
          from_length: {{ pfx.from_length }}
{%- endif %}
{%- if pfx.to_length is defined %}
          to_length: {{ pfx.to_length }}
{%- endif %}
{%- endfor %}
{%- endfor %}
{%- endif %}
{%- endif %}
{%- if contracts %}
    contracts:
{%- for c in contracts %}
    - name: {{ c.name }}
      scope: {{ c.scope }}
      subjects:
{%- for s in c.subjects %}
      - name: {{ s.name }}
        filters:
{%- for f in s.filters %}
        - filter: {{ f.filter }}
{%- endfor %}
{%- endfor %}
{%- endfor %}
{%- endif %}
{%- if filters %}
    filters:
{%- for f in filters %}
    - name: {{ f.name }}
      entries:
{%- for e in f.entries %}
      - name: {{ e.name }}
        ethertype: {{ e.ethertype }}
        protocol: {{ e.protocol }}
{%- if e.destination_from_port is defined %}
        destination_from_port: {{ e.destination_from_port }}
{%- endif %}
{%- if e.destination_to_port is defined %}
        destination_to_port: {{ e.destination_to_port }}
{%- endif %}
{%- endfor %}
{%- endfor %}
{%- endif %}
