# Shared management VLAN pool, physical domain and AAEP.
apic:
  access_policies:
    vlan_pools:
    - name: {{ config.physicalDomain }}-vlans
      allocation: static
      ranges:
      - from: {{ network.vlan }}
        to: {{ network.vlan }}
    physical_domains:
    - name: {{ config.physicalDomain }}
      vlan_pool: {{ config.physicalDomain }}-vlans
    aaeps:
    - name: {{ config.aaep }}
      physical_domains: [{{ config.physicalDomain }}]
