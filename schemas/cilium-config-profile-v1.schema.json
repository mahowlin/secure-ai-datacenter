{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saif.example.com/schemas/cilium-config-profile-v1.schema.json",
  "title": "SAIF CiliumConfig profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "networking.saif.example.com/v1alpha1"},
    "kind": {"const": "CiliumConfigProfile"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compatibility", "packageContractSha256", "valuesSchema", "values"],
      "properties": {
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ciliumVersions", "openshiftMinors"],
          "properties": {
            "ciliumVersions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
            },
            "openshiftMinors": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}
            }
          }
        },
        "packageContractSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "valuesSchema": {"type": "object"},
        "values": {"type": "object"},
        "chartValuesSchema": {"type": "object"},
        "chartValues": {"type": "object"}
      }
    }
  }
}
